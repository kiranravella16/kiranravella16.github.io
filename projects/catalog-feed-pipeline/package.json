{
  "name": "catalog-feed-pipeline",
  "version": "1.0.0",
  "description": "Event-driven multi-region supplier feed ingestion (US/MX/CA) with canonical item IDs and a GraphQL catalog API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "graphql": "^16.15.0",
    "graphql-yoga": "^5.24.6",
    "kafkajs": "^2.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
